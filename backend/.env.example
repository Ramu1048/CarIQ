# ==========================================
# CarIQ Backend — Environment Configuration
# ==========================================

# Application
APP_NAME="CarIQ Backend"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql+asyncpg://cariq_user:cariq_password@localhost:5432/cariq_db
# For sync operations (Alembic migrations)
SYNC_DATABASE_URL=postgresql://cariq_user:cariq_password@localhost:5432/cariq_db

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# AI Provider
# ==========================================
# Supported: gemini, openai, mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# CORS
# ==========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==========================================
# Payment Provider
# ==========================================
# Supported: mock, razorpay, stripe
PAYMENT_PROVIDER=mock
PAYMENT_KEY=
PAYMENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# Email Provider
# ==========================================
# Supported: mock, sendgrid, smtp
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=noreply@cariq.in
EMAIL_FROM_NAME=CarIQ

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ==========================================
# Caching
# ==========================================
CACHE_TTL_SECONDS=300
VEHICLE_CACHE_TTL=600

# ==========================================
# File Upload
# ==========================================
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
