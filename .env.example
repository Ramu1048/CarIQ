# CarIQ AI Service Configuration

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# AI Provider Configuration (gemini, openai, ollama, mock)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# Ollama Configuration (if AI_PROVIDER=ollama or as fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Database & Vector Store
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cariq_db
VECTOR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cariq_vectors
VECTOR_STORE_TYPE=memory  # Options: memory, pgvector, chromadb

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
CACHE_TTL_SECONDS=3600

# Embedding Configuration
EMBEDDING_PROVIDER=tfidf_fast  # Options: sentence_transformers, openai, tfidf_fast
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG & Retrieval Thresholds
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.65
RAG_MAX_CONTEXT_TOKENS=2500

# Security & Rate Limiting
API_KEY_ENABLED=false
SERVICE_API_KEY=cariq_secret_ai_service_key_2026
RATE_LIMIT_PER_MINUTE=100
